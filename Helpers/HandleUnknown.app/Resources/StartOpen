case "$1" in
  *.command)
    echo "Terminal runCommand:'$1'" | /usr/local/bin//stexec -
    exit $?
  ;;
  *.desktop)
    echo "Terminal runCommand:'$1'" | /usr/local/bin//stexec -
    exit $?
  ;;
  *)
  T=`file "$1"`
  ;;
esac

case "$T" in
  *script*ASCII?text?executable)
    /opt/gs-light/Library/Scripts/NSAlert "Executable Script" "file type $T" "Execute" "Edit"
    if [ "$?" -eq 1 ];then
      echo "Terminal runCommand:'$1'" | /usr/local/bin//stexec -
    else
      /usr/bin/gopen -a TextEdit "$1"
    fi
 
    exit $?
  ;;
  *ASCII?text*)
    /usr/bin/gopen -a TextEdit "$1"
    exit $?
  ;;
  *)
    /opt/gs-light/Library/Scripts/NSAlert "Unknown File" "file type $T"
    exit $?
  ;;
esac
