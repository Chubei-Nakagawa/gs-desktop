nxnotify show-panel --title "Help Filter" --info "converting to help"

case "$1" in
  *.gsdoc)
    perl "$PWD/Resources/gsdoc2help" "$1"
   ;;
  *.1|*.2|*.3|*.4|*.5|*.6|*.7|*.8|*.man)
    perl "$PWD/Resources/man2help" "$1"
   ;;
  *.info)
    perl "$PWD/Resources/info2help" "$1"
   ;;
esac

/usr/local/bin/nxnotify hide-panel
