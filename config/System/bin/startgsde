#!/usr/bin/env bash

GSBASE_DIR="/usr/bin"
GSDESKTOP_BINDIR="/usr/local/bin"
WMAKER_BINDIR="/opt/WindowMaker/bin"
GSLIGHT_SYSDIR="/lib/x86_64-linux-gnu/GNUstep"
GSLIGHT_LIBDIR="/usr/local/lib/GNUstep"
HOME_LIBDIR="${HOME}/GNUstep/Library"

function show_status {
  if [ -n "$1" ];then
    echo "status: $1"
    ${WMAKER_BINDIR}/wmshowstatus "$1" $2 || exit 1
  else
    ${WMAKER_BINDIR}/wmshowstatus
  fi
}

function start_windowmanager {
  rm $FONTCONFIG_FILE
  show_status "starting windowmanager" "gray45"
  ${WMAKER_BINDIR}/wmaker $WM_ARGS
  export WMAKER_BIN_PID="$!"
  show_status "stopping windowmanager" "gray45"
}

function continue_in_wm  {
  echo "windowmanager running on $WMAKER_BIN_PID"
  echo "$WMAKER_BIN_PID" > /tmp/$UID-wm.pid

  show_status "about to autostart apps"
  ${GSLIGHT_LIBDIR}/Scripts/AutoLaunchApps

  show_status "about to start Notification Monitor"
  #${GSLIGHT_SYSDIR}/Applications/NotMon.app/NotMon -GSSuppressAppIcon YES -autolaunch YES &
  ${GSDESKTOP_BINDIR}/NotMon -GSSuppressAppIcon YES -autolaunch YES &
  echo "$!" > /tmp/$UID-notmon.pid

  show_status "about to start Gesture Helper"
  #${GSLIGHT_SYSDIR}/Applications/GestureHelper.app/GestureHelper -GSSuppressAppIcon YES -autolaunch YES &
  ${GSDESKTOP_BINDIR}/GestureHelper -GSSuppressAppIcon YES -autolaunch YES &
  echo "$!" > /tmp/$UID-ghelper.pid
  xrefresh
}

function start_services {
  show_status "about to start gdomap" "gray15"
  ${GSBASE_DIR}/defaults write NSGlobalDomain NSPortIsMessagePort NO
  ${GSBASE_DIR}/defaults write NSGlobalDomain NSHostNameIsLocalhost YES

  ${GSBASE_DIR}/gdomap -f &
  echo "$!" > /tmp/$UID-gdomap.pid
  sleep 0.5

  show_status "about to start Notification Center" "gray20"
  ${GSBASE_DIR}/gdnc --daemon &
  echo "$!" > /tmp/$UID-gdnc.pid
  sleep 0.5

  show_status "about to start Pasteboard Service" "gray25"
  ${GSBASE_DIR}/gpbs --daemon &
  echo "$!" > /tmp/$UID-gpbs.pid
  sleep 0.3

  # needed to start synchronizing the X11 CLIPBOARD
  echo " " | ${GSDESKTOP_BINDIR}/nxpasteboard --copy

  # needed to start PA audio sever
  ${GSDESKTOP_BINDIR}/nxaudio --status

  show_status "about to start fswatcher Service" "gray30"
  ${GSDESKTOP_BINDIR}/fswatcher --daemon &
  echo "$!" > /tmp/$UID-fswatcher.pid
  sleep 0.3

  show_status "about to start ddbd Service" "gray35"
  ${GSDESKTOP_BINDIR}/ddbd --daemon &
  echo "$!" > /tmp/$UID-ddbd.pid
  sleep 0.3

  show_status "making services" "gray40"
  ${GSBASE_DIR}/make_services
}

function _kill_proc {
  PID=`cat /tmp/$UID-$1.pid 2>/dev/null`
  if [ -n "$PID" ];then
    kill $PID 2> /dev/null 
    rm /tmp/$UID-$1.pid
    sleep 0.3
  fi
}

function stop_services {
  show_status "about to stop ddbd Service"
  _kill_proc ddbd

  show_status "about to stop fswatcher Service"
  _kill_proc fswatcher

  show_status "about to stop Notification Monitor"
  _kill_proc notmon

  show_status "about to stop Gesture Helper"
  _kill_proc ghelper

  show_status "about to stop Pasteboard Service"
  _kill_proc gpbs

  show_status "about to stop Notification Center"
  _kill_proc gdnc

  show_status "about to stop gdomap"
  _kill_proc gdomap
}

function init_config {
  show_status "init config" "gray10"

  if [ ! -f "${HOME_LIBDIR}/etc/GSDE.conf" ];then
    echo "init user defaults"
    mkdir "${HOME_LIBDIR}" 2>/dev/null
    cp -fR /etc/skel/Library/* "${HOME_LIBDIR}"
  fi
 
  if [ ! -f "${HOME_LIBDIR}/WindowMaker/Defaults" ];then
    echo "init WindowMaker defaults"
    ${WMAKER_BINDIR}/wmaker.inst --batch
    mkdir -p "${HOME_LIBDIR}/WindowMaker/Defaults"
    cp ${GSLIGHT_SYSDIR}/etc/WindowMaker/WMRootMenu "${HOME_LIBDIR}/WindowMaker/Defaults"
  fi

  if [ ! -f "${HOME_LIBDIR}/Preferences/NSGlobalDomain.plist" ];then
    echo "init user preferences defaults"
    mkdir "${HOME_LIBDIR}/Preferences" 2>/dev/null
    cp ${GSLIGHT_LIBDIR}/Preferences/* "${HOME_LIBDIR}/Preferences/"

    mkdir "${HOME_LIBDIR}/Preferences/.NextSpace" 2>/dev/null
    cp ${GSLIGHT_LIBDIR}/Preferences/.NextSpace/* "${HOME_LIBDIR}/Preferences/.NextSpace"
  fi

  TZ=`defaults read NSGlobalDomain "Local Time Zone" 2>/dev/null`
  TZ=${TZ:33}
  if [ -n "$TZ" ]; then
    echo "setting session timezone to $TZ"
    export TZ
  else
    if [ -f /etc/timezone ]; then
      TZ=`cat /etc/timezone`
    else
      TZ=`timedatectl | grep "Time zone" |sed 's#.*:\ \([A-Za-z/]*\).*$#\1#'`
    fi
    echo "setting default timezone to $TZ"
    defaults write NSGlobalDomain "Local Time Zone" $TZ
  fi

  T="/tmp/$UID-gs-desktop.locale"
  ${GSDESKTOP_BINDIR}/mklocalconfig > "$T"
  source "$T"
  if [ -n "$LANG" ];then
    echo "desktop locale set to $LANG"
    export LANG
  fi
  if [ -n "$GNUSTEP_STRING_ENCODING" ];then
    echo "set default encoding to $GNUSTEP_STRING_ENCODING"
    export GNUSTEP_STRING_ENCODING
  fi

  defaults read NSGlobalDomain "GSBackend" 2>&1 > /dev/null
  if [ $? -ne 0 ]; then
    echo "setting default backend to Cairo"
    defaults write NSGlobalDomain "GSBackend" "cairo"
  fi

  HN=`hostname`
  if [ -n "$HN" ];then
    defaults write GWorkspace WorkspaceName "$HN"
  fi

  ${GSDESKTOP_BINDIR}/mkfontconfig
  if [ -f "${HOME_LIBDIR}/etc/fonts.conf" ];then
    export FONTCONFIG_FILE=${HOME_LIBDIR}/etc/fonts.conf
  fi
 
  ${WMAKER_BINDIR}/wdwrite WMWindowAttributes 'GSDE-Safe-Mode.XTerm'  '{ DontSaveSession = Yes; NoAppIcon = Yes; StartMiniaturized = Yes; Omnipresent = Yes; }'
  ${WMAKER_BINDIR}/wdwrite WMWindowAttributes 'GWorkspace.GNUstep'    '{ DontSaveSession = Yes; NoAppIcon = Yes; }'
  ${WMAKER_BINDIR}/wdwrite WMWindowAttributes 'GestureHelper.GNUstep' '{ DontSaveSession = Yes; NoAppIcon = Yes; }'
  ${WMAKER_BINDIR}/wdwrite WMWindowAttributes 'NotMon.GNUstep'        '{ DontSaveSession = Yes; SkipWindowList = Yes; SkipSwitchPanel = Yes; NoAppIcon = Yes; KeepOnTop = Yes; Omnipresent = Yes; }'
  ${WMAKER_BINDIR}/wdwrite WMWindowAttributes 'NotMon.MessageWindow'  '{ Unfocusable = Yes; }'
 
  if [ -f "$HOME/.gsderc" ];then
    echo "sourcing $HOME/.gsderc"
    source "$HOME/.gsderc"
  fi
}

function start_debug {
  WM_ARGS="--no-autolaunch --static --dont-restore"

  show_status "starting debug session" "black"
  init_config
  main_process
  cleanup
}

function save_screen {
  autorandr --force -s gsdesktop
}

function restore_screen {
  show_status "restoring screen"
  autorandr -c
}

function start_normal {
  WM_ARGS="--no-autolaunch --dont-restore"

  show_status "starting normal session" "black"
  restore_screen
  init_config
  main_process
  save_screen
  cleanup
}

function main_process {
  start_services
  start_windowmanager
}

function exec_last_wish {
  if [ -f "$GS_DESKTOP_LOGOUT_CMD" ];then
    echo "exec command after logout"
    source "$GS_DESKTOP_LOGOUT_CMD"
  fi
}

function cleanup {
  echo "cleaning up..."

  echo "make sure GWorkspace terminates"
  ${GSDESKTOP_BINDIR}/nxworkspace --terminate 2>/dev/null
  sleep 0.5
 
  stop_services

  show_status "the end" "black"
  echo -e "\e[3;0;0t\ePtmux;\e\e[3;0;0t\e\\"

  exec_last_wish

  sleep 0.5
  pkill -P "$$"

  exit 0
}

if [ "$1" == "--continue-in-wm" ];then
  continue_in_wm
  exit 0
fi

if [ "$UID" -eq 0 ];then
  echo "GNUstep Desktop cannot run as root"
  exit 1
fi

if ! xset b 0 ;then
  if [ -n "$DISPLAY" ];then
    echo "unable to open $DISPLAY"
    exit 1
  else
    echo "executing startx"
    exec startx ${GSDESKTOP_BINDIR}/startgsde $*
  fi
fi

echo "=================================================="
echo " Starting GNUstep Desktop"
echo "=================================================="

if [ "$1" == "--safe-mode-continue" ];then
  export GS_DESKTOP_SAFEMODE="safe"
  echo ""

  echo "you are running in the safe mode"
  echo "WARNING: you will not be able to modify the dock!"
  echo ""
  echo "use use the following commands to start:"
  echo ""
  echo " ${GSDESKTOP_BINDIR}/startgsde        - start the desktop"
  echo " ${GSDESKTOP_BINDIR}/startgsde-xnest  - use separate Xserver (Xnest)"
  echo " ${GSDESKTOP_BINDIR}/startgsde-wmaker - start the wm (very limited!)"
  echo ""

  exec $SHELL
fi

if [ "$1" == "--safe-mode" ];then
  exec xterm -xrm '*.allowWindowOps:true' -bg black -fg gray -bd green -geometry 160x24+0+0 -name GSDE-Safe-Mode -e "$0" --safe-mode-continue
fi

show_status "the beginning" "black"

## set system env variables
export WMAKER_USER_ROOT="${HOME_LIBDIR}/WindowMaker"
export PATH="${HOME_LIBDIR}/Scripts:${GSLIGHT_LIBDIR}/Scripts:${WMAKER_BINDIR}:${PATH}"
export MANPATH=":${GSLIGHT_SYSDIR}/share/man:${GSLIGHT_LIBDIR}/Documentation/man"
export GS_DESKTOP_LOG="/tmp/$UID-gs-desktop.log"
export GS_DESKTOP_ID="$$"
export BROWSER="${GSDESKTOP_BINDIR}/nxbrowser"
export GS_DESKTOP_LOGOUT_CMD="/tmp/$UID-logout.cmd"

## unset envs in case we are running from a terminal window
unset XTERM_VERSION
unset XTERM_SHELL
unset XTERM_LOCAL

## clean up
rm -R "/tmp/GNUstepSecure$UID" 2>/dev/null
rm "$GS_DESKTOP_LOGOUT_CMD" 2>/dev/null

#source /Developer/Makefiles/GNUstep.sh
source /usr/share/GNUstep/Makefiles/GNUstep.sh

WM_ARGS=""

if [ -t 0 ];then
  echo "running interactive"
  trap cleanup SIGINT
fi

if [ -n "$GS_DESKTOP_SAFEMODE" ];then
  echo "running in SAFE mode"
  if [ "$GS_DESKTOP_SAFEMODE" = "xnest" ];then
    echo "logging to $GS_DESKTOP_LOG"
    start_debug > $GS_DESKTOP_LOG 2>&1
  else
    start_debug |& tee $GS_DESKTOP_LOG
  fi
else
  start_normal > $GS_DESKTOP_LOG 2>&1
fi
