(
  "Window Maker",
  (Info, ("Info Panel...", INFO_PANEL), (Preferences..., EXEC, WPrefs)),
  (Workspaces, WORKSPACE_MENU),
  (
    Desktop,
    (
      Audio,
      (
        "+",
        SHORTCUT,
        XF86AudioRaiseVolume,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/AudioIncreaseVolume"
      ),
      (
        "-",
        SHORTCUT,
        XF86AudioLowerVolume,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/AudioDecreaseVolume"
      ),
      (
        Mute,
        SHORTCUT,
        XF86AudioMute,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/AudioToggleMute"
      )
    ),
    (
      Display,
      (
        "+",
        SHORTCUT,
        XF86MonBrightnessUp,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/DisplayIncreaseBrightness"
      ),
      (
        "-",
        SHORTCUT,
        XF86MonBrightnessDown,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/DisplayDecreaseBrightness"
      )
    ),
    (
      Keyboard,
      (
        "Backlight On",
        SHORTCUT,
        XF86KbdBrightnessUp,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/KeyboardIncreaseBacklight"
      ),
      (
        "Backlight Off",
        SHORTCUT,
        XF86KbdBrightnessDown,
        EXEC,
        "/usr/local/lib/GNUstep/Scripts/KeyboardDecreaseBacklight"
      )
    ),
    (
      "Grab ScreenShot",
      (Selection, EXEC, "/usr/local/lib/GNUstep/Scripts/ScreenShotSelection"),
      (Window, EXEC, "/usr/local/lib/GNUstep/Scripts/ScreenShotWindow"),
      (Screen, EXEC, "/usr/local/lib/GNUstep/Scripts/ScreenShotScreen")
    )
  ),
  (Windows, WINDOWS_MENU),
  ("Show Workspace", EXEC, "/usr/local/bin/nxworkspace --fileviewer"),
  ("System Preferences...", EXEC, "/usr/bin/gopen -a Preferences"),
  (
    "Show Launcher",
    SHORTCUT,
    "Control+space",
    EXEC,
    "/usr/local/lib/GNUstep/Scripts/ShowLauncher"
  ),
  (
    Logout,
    ("Terminate User Session", EXEC, "/usr/local/lib/GNUstep/Scripts/WorkspaceLogout"),
    ("Power Off", EXEC, "/usr/local/lib/GNUstep/Scripts/WorkspacePoweroff")
  )
)
